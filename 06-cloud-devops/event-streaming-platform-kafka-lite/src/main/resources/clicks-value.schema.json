{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foundev.local/schemas/clicks-value.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "session_id",
    "url",
    "user_agent",
    "ts"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "ts": {
      "type": "number"
    },
    "geo": {
      "type": "string"
    },
    "device": {
      "type": "string"
    }
  }
}
