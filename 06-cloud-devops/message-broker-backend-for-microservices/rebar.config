%% rebar3 project for message-broker-backend-for-microservices
%%
%% amqp_client and rabbit_common are the RabbitMQ Erlang client libraries
%% (published to hex.pm); prometheus is the prometheus-erl exposition
%% library. The 4.3 series is used because the 3.13 series of rabbit_common
%% does not build on OTP 26 and later.
{erl_opts, [debug_info,
            warn_unused_vars,
            warn_unused_import,
            warn_missing_spec]}.

{deps, [
    {amqp_client, "4.3.4"},
    {rabbit_common, "4.3.4"},
    {prometheus, "6.1.3"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [message_broker_backend]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {message_broker_backend, "0.1.0"},
     [message_broker_backend, sasl]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [{relx, [{dev_mode, false}, {include_src, false}]}]}
]}.
