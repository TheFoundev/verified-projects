%% Runtime configuration for message_broker_backend.
[
 {message_broker_backend, [
    %% Inside docker-compose the MBB_AMQP_HOST OS variable overrides this
    %% with "rabbitmq" (see mbb_connection:cfg/1).
    {amqp_host, "localhost"},
    {amqp_port, 5672},
    {amqp_username, <<"guest">>},
    {amqp_password, <<"guest">>},
    {amqp_vhost, <<"/">>},
    {heartbeat_seconds, 30},
    {prefetch_count, 32},
    {backoff_base_ms, 500},
    {backoff_max_ms, 30000},
    {max_retries, 3},
    {retry_ttl_base_ms, 5000},
    {confirm_timeout_ms, 5000},
    {publish_max_attempts, 3},
    {seen_ttl_ms, 600000},
    {http_port, 8080},
    {burst_count, 500},
    {burst_rate, 200}
 ]},
 {kernel, [
    {logger_level, info},
    {logger,
     [{handler, default,
       logger_std_h,
       #{level => info,
         formatter => {logger_formatter,
                       #{template => [time, " ", level, " ", msg, "\n"],
                         time_designator => $T}}}}]}
 ]},
 {sasl, [
    {sasl_error_logger, {file, "log/sasl.log"}}
 ]}
].
